name: Actualizar posts desde RSSHub

on:
  schedule:
    - cron: '*/30 * * * *'  # Cada 30 minutos
  workflow_dispatch:        # Ejecución manual

permissions:
  contents: write

jobs:
  update-feed:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          fetch-depth: 0  # Obtener todo el historial para rebase

      - name: Pull latest changes before modifying
        run: |
          git pull --rebase origin main

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Fetch fresh posts from RSSHub
        id: fetch
        run: |
          RSSHUB_BASE="https://rsshub.app"
          FEEDS=(
            "$RSSHUB_BASE/twitter/user/MariaCorinaYA"
            "$RSSHUB_BASE/twitter/user/VenteVenezuela"
            "$RSSHUB_BASE/twitter/search/q=%23VenteVenezuela"
            "$RSSHUB_BASE/twitter/search/q=%23MariaCorina"
            "$RSSHUB_BASE/twitter/search/q=%23VenezuelaLibre"
          )

          ALL_POSTS=()
          for feed in "${FEEDS[@]}"; do
            echo "Fetching: $feed"
            RESPONSE=$(curl -sfH "Accept: application/json" --max-time 15 "$feed" 2>/dev/null || echo '{"items":[]}')
            ITEMS=$(echo "$RESPONSE" | jq -c '.items // .data // []')
            COUNT=$(echo "$ITEMS" | jq 'length')
            echo "  -> $COUNT items"
            
            for i in $(seq 0 $((COUNT-1))); do
              ITEM=$(echo "$ITEMS" | jq -c ".[$i]")
              LINK=$(echo "$ITEM" | jq -r '.link // ""')
              [ -z "$LINK" ] && continue
              
              ID=$(basename "$LINK")
              PUBDATE=$(echo "$ITEM" | jq -r '.pubDate // ""')
              DATE_OBJ=$(date -d "$PUBDATE" 2>/dev/null || date)
              DATE_STR=$(date -d "$DATE_OBJ" '+%d %b %Y' | sed 's/Jan/ene/;s/Feb/feb/;s/Mar/mar/;s/Apr/abr/;s/May/may/;s/Jun/jun/;s/Jul/jul/;s/Ago/ago/;s/Sep/sep/;s/Oct/oct/;s/Nov/nov/;s/Dic/dic/')
              TIME_STR=$(date -d "$DATE_OBJ" '+%H:%M')
              CONTENT=$(echo "$ITEM" | jq -r '.content // .contentSnippet // .title // ""')
              TEXT=$(echo "$CONTENT" | sed 's/<[^>]*>//g' | sed 's/&[a-z]*;/ /gi' | head -c 500)
              IMG=$(echo "$CONTENT" | grep -oE 'src=["'"'"'][^"'"'"']+["'"'"']' | head -1 | sed 's/src=["'"'"']//;s/["'"'"']$//')
              
              # Detectar autor por fuente
              if [[ "$feed" == *"MariaCorinaYA"* ]]; then AUTHOR="MariaCorinaYA";
              elif [[ "$feed" == *"VenteVenezuela"* ]]; then AUTHOR="VenteVenezuela";
              else AUTHOR="hashtag"; fi
              
              POST=$(jq -n \
                --arg id "$ID" \
                --arg author "$AUTHOR" \
                --arg text "$TEXT" \
                --arg date "$DATE_STR" \
                --arg time "$TIME_STR" \
                --arg link "$LINK" \
                --arg img "$IMG" \
                '{id: $id, author: $author, text: $text, date: $date, time: $time, replies: 0, reposts: 0, likes: 0, photos: (if $img != "" then [$img] else [] end), link: $link}')
              ALL_POSTS+=("$POST")
            done
          done

          UNIQUE_POSTS=$(printf '%s\n' "${ALL_POSTS[@]}" | jq -s 'unique_by(.link) | .[:30]')
          echo "$UNIQUE_POSTS" > rsshub_posts.json
          echo "Total unique posts: $(echo "$UNIQUE_POSTS" | jq 'length')"

      - name: Update index.html FEED_POSTS array
        run: |
          node << 'EOF'
          const fs = require('fs');
          let html = fs.readFileSync('index.html', 'utf8');
          const fresh = JSON.parse(fs.readFileSync('rsshub_posts.json', 'utf8'));
          
          if (fresh.length === 0) {
            console.log('No fresh posts, skipping update');
            process.exit(0);
          }
          
          // Convertir a formato JS string
          const postsJs = fresh.map(p => 
            `            { id: "${p.id}", author: "${p.author}", text: \`${p.text.replace(/`/g, '\\`')}\`, date: "${p.date}", time: "${p.time}", replies: ${p.replies}, reposts: ${p.reposts}, likes: ${p.likes}, photos: ${JSON.stringify(p.photos)}, link: "${p.link}" }`
          ).join(',\n');
          
          // Reemplazar el array FEED_POSTS completo
          const startMarker = 'const FEED_POSTS = [';
          const endMarker = '        ];';
          
          const startIdx = html.indexOf(startMarker);
          if (startIdx === -1) {
            console.error('FEED_POSTS marker not found');
            process.exit(1);
          }
          
          const endIdx = html.indexOf(endMarker, startIdx);
          if (endIdx === -1) {
            console.error('FEED_POSTS end marker not found');
            process.exit(1);
          }
          
          const newFeedPosts = startMarker + '\n' + postsJs + '\n' + endMarker;
          html = html.slice(0, startIdx) + newFeedPosts + html.slice(endIdx + endMarker.length);
          
          fs.writeFileSync('index.html', html);
          console.log(`Updated FEED_POSTS with ${fresh.length} fresh posts`);
          EOF

      - name: Commit and push if changed
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          # Pull latest again before committing to avoid conflicts
          git pull --rebase origin main
          if git diff --quiet index.html; then
            echo "No changes to commit"
          else
            git add index.html
            git commit -m "feed: actualización automática desde RSSHub ($(date -u +'%Y-%m-%d %H:%M UTC'))"
            git push
          fi