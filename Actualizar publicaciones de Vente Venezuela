name: Actualizar publicaciones de Vente Venezuela

# Actualiza las publicaciones del feed cada 6 horas. El workflow anterior
# (rsshub-update) se elimino porque pisaba el codigo de index.html cuando se
# cruzaba con un push manual. Este solo modifica el array FEED_POSTS, nunca
# reescribe el resto del archivo, y si el cambio no es del feed no hace commit.
on:
  schedule:
    - cron: '0 */6 * * *'
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: feed-update
  cancel-in-progress: false

jobs:
  update-feed:
    runs-on: ubuntu-latest
    steps:
      - name: Clonar el repositorio
        uses: actions/checkout@v4
        with:
          ref: main
          fetch-depth: 0

      - name: Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Descargar publicaciones recientes
        run: node .github/scripts/actualizar-feed.mjs

      - name: Validar index.html
        run: node .github/scripts/validar-feed.mjs

      - name: Publicar cambios
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add index.html
          if git diff --cached --quiet; then
            echo "No hay publicaciones nuevas."
          else
            git commit -m "feed: publicaciones actualizadas ($(date -u +'%Y-%m-%d %H:%M UTC'))"
            # Antes de subir, se comprueba que nadie subio nada mientras tanto.
            git pull --rebase origin main
            git push origin HEAD:main
          fi
